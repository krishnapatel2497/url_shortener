<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact - URL Shortener</title>
    <link rel="stylesheet" href="/style.css" />
  </head>

  <body>
    <%- include("partials/header") %>

    <main class="page-container">
      <section class="contact-section">
        <div class="contact-header">
          <span class="contact-badge">GET IN TOUCH</span>

          <h1>Contact Us</h1>

          <p>
            Have a question, suggestion, or feedback? We'd love to hear from
            you.
          </p>
        </div>

        <div class="contact-grid">
          <!-- Contact Information -->
          <div class="contact-card">
            <h2>Contact Information</h2>

            <div class="contact-item">
              <div class="contact-icon">✉</div>
              <div>
                <span>Email</span>
                <strong>jinupatel1997@gmail.com</strong>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">☎</div>
              <div>
                <span>Phone</span>
                <strong>+91 99999 99999</strong>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">⌖</div>
              <div>
                <span>Address</span>
                <strong>Surat, Gujarat, India</strong>
              </div>
            </div>
          </div>

          <!-- Message -->
          <div class="contact-card contact-message">
            <h2>We'd Love to Hear From You</h2>

            <p>
              Your feedback helps us improve our URL Shortener and provide a
              better experience for everyone.
            </p>

            <p>
              Whether you found a problem, have an idea for a new feature, or
              simply want to share your experience, feel free to reach out.
            </p>

            <div class="contact-note">
              <span>💡</span>
              <p>We appreciate your feedback and suggestions.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <%- include("partials/footer") %>
  </body>
</html>
