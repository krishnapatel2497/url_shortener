<%- include("../partials/header") %>

<main class="profile-page">
  <h1 class="profile-title">Edit Profile</h1>

  <div class="login-status">
    <span class="status-dot"></span>
    Update your profile information
  </div>

  <section class="profile-card edit-profile-card">
    <div class="edit-profile-header">
      <div class="edit-avatar">
        <i class="fa-solid fa-user"></i>
      </div>

      <div>
        <h2>Profile Information</h2>
        <p>Keep your account details up to date.</p>
      </div>
    </div>

    <form action="/profile/edit" method="POST" class="edit-profile-form">
      <div class="form-group">
        <label for="name">
          <i class="fa-solid fa-user"></i>
          Name
        </label>

        <input
          type="text"
          id="name"
          name="name"
          value="<%= profileUser.name %>"
          placeholder="Enter your name"
          autocomplete="name"
          required
        />
      </div>

      <div class="form-group">
        <label for="email">
          <i class="fa-solid fa-envelope"></i>
          Email Address
        </label>

        <input
          type="email"
          id="email"
          name="email"
          value="<%= profileUser.email %>"
          placeholder="Enter your email"
          autocomplete="email"
          required
        />
      </div>

      <div class="edit-profile-note">
        <i class="fa-solid fa-circle-info"></i>
        <span
          >Your email address is used for account verification and login.</span
        >
      </div>

      <div class="profile-actions">
        <a href="/profile" class="profile-button cancel-button">
          <i class="fa-solid fa-arrow-left"></i>
          Cancel
        </a>

        <button type="submit" class="profile-button save-button">
          <i class="fa-solid fa-check"></i>
          Save Changes
        </button>
      </div>
    </form>
  </section>
</main>
