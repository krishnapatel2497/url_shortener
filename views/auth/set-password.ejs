<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Set Password</title>
</head>

<body>

    <%- include('../partials/header', { title: "Set Password" }) %>

    <main class="auth-container">

        <h1>Set Password</h1>

        <p>
            Create a password so you can also login
            using your email and password.
        </p>


        <!-- Error Messages -->

        <% if (errors && errors.length > 0) { %>

            <% errors.forEach((error) => { %>

                <p class="flash-error">
                    <%= error %>
                </p>

            <% }); %>

        <% } %>


        <!-- Success Messages -->

        <% if (success && success.length > 0) { %>

            <% success.forEach((message) => { %>

                <p class="flash-success">
                    <%= message %>
                </p>

            <% }); %>

        <% } %>


        <!-- Set Password Form -->

        <form
            action="/set-password"
            method="POST"
            class="auth-form"
        >

            <div class="form-group">

                <label for="password">
                    New Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter your new password"
                    minlength="6"
                    required
                >

            </div>


            <div class="form-group">

                <label for="confirmPassword">
                    Confirm Password
                </label>

                <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    placeholder="Confirm your new password"
                    minlength="6"
                    required
                >

            </div>


            <button type="submit">
                Set Password
            </button>

        </form>

    </main>

    <%- include('../partials/footer') %>

</body>
</html>