<%- include('./partials/header', { title: "URL Shortner" }) %>

<% if (user) { %>                        
    <h2>You are logged In</h2>
<% } else { %>
    <h2>You are not logged In</h2>
<% } %>

<div class="container">

    <h1>URL Shortner</h1>

    <p class="subtitle">
        Convert long URLs into short and shareable links.
    </p>


      <!-- Zod validation error -->
    <% if (errors && errors.length > 0) { %>
    <div class="error-message">
        <%= errors[0] %>
    </div>
    <% } %>

       <!-- Success message -->
    <% if (success && success.length > 0) { %>
    <div class="success-message">
        <%= success[0] %>
    </div>
    <% } %>

    <form action="/" method="post">

        <div class="form-group">
            <label for="url">Original URL</label>

            <input
                type="text"
                id="url"
                name="url"
                placeholder="https://example.com"
                required
            />
        </div>

        <div class="form-group">
            <label for="shortCode">Custom Short Code</label>

            <input
                type="text"
                id="shortCode"
                name="shortCode"
                placeholder="my-link"
                required
            />
        </div>

        <button type="submit">
            Shorten URL
        </button>

    </form>

    <h2>Your Shortened URLs</h2>

    <ul>
        <% links.forEach((link) => { %>

            <%
                const truncatedURL =
                    link.url.length >= 30
                        ? `${link.url.slice(0, 30)}...`
                        : link.url;
            %>

           <li class="short-url-item">
    <div class="short-url-info">
        <a
            href="/<%= link.shortCode %>"
            target="_blank"
        >
            <%= host %>/<%= link.shortCode %>
        </a>

        <span>- <%= truncatedURL %></span>
    </div>

    <div class="short-url-actions">

        <!-- Copy Button -->
        <button
            type="button"
            class="action-btn copy-btn"
            data-url="<%= host %>/<%= link.shortCode %>"
            title="Copy short URL"
        >
             <i class="fa-solid fa-link"></i>
        </button>

        <!-- Edit Button -->
        <a
            href="/shortener/edit/<%= link._id %>"
            class="action-btn edit-btn"
            title="Edit short URL"
        >
         <i class="fa-solid fa-pen-to-square"></i>
        </a>

        <!-- Delete Button -->
        <form
            action="/shortener/delete/<%= link._id %>"
            method="POST"
            class="delete-form"
            onsubmit="return confirm('Are you sure you want to delete this short URL?');"
        >
            <button
                type="submit"
                class="action-btn delete-btn"
                title="Delete short URL"
            >
                <i class="fa-solid fa-trash"></i>
            </button>
        </form>

    </div>
</li>
 <% }) %>
    </ul>

</div>

<script>
    document.querySelectorAll(".copy-btn").forEach((button) => {
  button.addEventListener("click", async () => {
    const url = button.dataset.url;
    const icon = button.querySelector("i");

    try {
      await navigator.clipboard.writeText(url);

      // Change only the icon
      icon.classList.remove("fa-link");
      icon.classList.add("fa-check");

      setTimeout(() => {
        icon.classList.remove("fa-check");
        icon.classList.add("fa-link");
      }, 1500);
    } catch (error) {
      console.error("Failed to copy URL:", error);
    }
  });
});
</script>

<%- include('./partials/footer') %>