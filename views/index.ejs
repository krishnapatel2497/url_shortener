
<%- include('./partials/header', { title: "URL Shortener" }) %>

<main class="url-page">

  <!-- Hero Section -->
  <section class="url-hero">

    <div class="hero-badge">
      ✦ SIMPLE & FAST URL SHORTENER
    </div>

    <h1>Shorten Your URLs</h1>

    <p>
      Convert long URLs into short, clean, and shareable links.
    </p>

    <% if (user) { %>
      <div class="login-status">
        <span class="status-dot"></span>
        You are logged in
      </div>
    <% } else { %>
      <div class="login-status">
        <span class="status-dot"></span>
        You are not logged in
      </div>
    <% } %>

  </section>


  <!-- URL Shortener Card -->
  <section class="shortener-card">

    <div class="card-heading">
      <div>
        <h2>Create Short URL</h2>
        <p>Enter your long URL and create a custom short link.</p>
      </div>

      <div class="heading-icon">
        <i class="fa-solid fa-link"></i>
      </div>
    </div>


    <!-- Zod validation error -->
    <% if (errors && errors.length > 0) { %>
      <div class="message error-message">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span><%= errors[0] %></span>
      </div>
    <% } %>


    <!-- Success message -->
    <% if (success && success.length > 0) { %>
      <div class="message success-message">
        <i class="fa-solid fa-circle-check"></i>
        <span><%= success[0] %></span>
      </div>
    <% } %>


    <form action="/" method="post" class="shortener-form">

      <div class="form-group">
        <label for="url">Original URL</label>

        <div class="input-wrapper">
          <i class="fa-solid fa-globe"></i>

          <input
            type="url"
            id="url"
            name="url"
            placeholder="https://example.com/very-long-url"
            autocomplete="url"
            required
          />
        </div>
      </div>


      <div class="form-group">
        <label for="shortCode">Custom Short Code</label>

        <div class="input-wrapper">
          <i class="fa-solid fa-hashtag"></i>

          <input
            type="text"
            id="shortCode"
            name="shortCode"
            placeholder="my-link"
            autocomplete="off"
            required
          />
        </div>
      </div>


      <button type="submit" class="shorten-btn">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        Shorten URL
      </button>

    </form>

  </section>


  <!-- Your Links -->
  <section class="links-section">

    <div class="section-heading">
      <div>
        <h2>Your Shortened URLs</h2>
        <p>Manage and share your shortened links.</p>
      </div>

      <span class="link-count">
        <%= links.length %> Links
      </span>
    </div>


    <% if (links.length === 0) { %>

      <div class="empty-links">
        <div class="empty-icon">
          <i class="fa-solid fa-link-slash"></i>
        </div>

        <h3>No shortened URLs yet</h3>

        <p>
          Create your first short URL using the form above.
        </p>
      </div>

    <% } else { %>

      <div class="links-list">

        <% links.forEach((link) => { %>

          <% 
            const truncatedURL =
              link.url.length >= 45
                ? `${link.url.slice(0, 45)}...`
                : link.url;
            const shortUrl = `${host}/${link.shortCode}`;
          %>


          <article class="short-url-item">

            <div class="short-url-info">

              <div class="short-link-icon">
                <i class="fa-solid fa-link"></i>
              </div>

              <div class="url-details">

                <a
                  href="/<%= link.shortCode %>"
                  target="_blank"
                  class="short-link"
                >
                  <%= host %>/<%= link.shortCode %>
                </a>

                <span class="original-url">
                  <%= truncatedURL %>
                </span>

              </div>

            </div>


            <div class="short-url-actions">

              <!-- Copy -->
              <button
                type="button"
                class="action-btn copy-btn"
                data-url="<%= host %>/<%= link.shortCode %>"
                title="Copy short URL"
              >
                <i class="fa-solid fa-copy"></i>
              </button>


              <!-- Edit -->
              <a
                href="/shortener/edit/<%= link._id %>"
                class="action-btn edit-btn"
                title="Edit short URL"
              >
                <i class="fa-solid fa-pen-to-square"></i>
              </a>


              <!-- Delete -->
              <form
                action="/shortener/delete/<%= link._id %>"
                method="POST"
                class="delete-form"
                onsubmit="return confirm('Are you sure you want to delete this short URL?');"
              >

                <button
                  type="submit"
                  class="action-btn delete-btn"
                  title="Delete short URL"
                >
                  <i class="fa-solid fa-trash"></i>
                </button>

              </form>

            </div>

          </article>

        <% }) %>

      </div>

    <% } %>

  </section>

</main>


<script>
  document.querySelectorAll(".copy-btn").forEach((button) => {

    button.addEventListener("click", async () => {

      const url = button.dataset.url;

      const icon = button.querySelector("i");

      try {

        await navigator.clipboard.writeText(url);

        icon.classList.remove("fa-copy");
        icon.classList.add("fa-check");

        button.classList.add("copied");

        setTimeout(() => {

          icon.classList.remove("fa-check");
          icon.classList.add("fa-copy");

          button.classList.remove("copied");

        }, 1500);

      } catch (error) {

        console.error("Failed to copy URL:", error);

      }

    });

  });
</script>


<%- include('./partials/footer') %>

