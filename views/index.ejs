<%- include('./partials/header', { title: "URL Shortner" }) %>

<div class="container">

    <h1>URL Shortner</h1>

    <p class="subtitle">
        Convert long URLs into short and shareable links.
    </p>

    <form action="/" method="post">

        <div class="form-group">
            <label for="url">Original URL</label>

            <input
                type="url"
                id="url"
                name="url"
                placeholder="https://example.com"
                required
            />
        </div>

        <div class="form-group">
            <label for="shortCode">Custom Short Code</label>

            <input
                type="text"
                id="shortCode"
                name="shortCode"
                placeholder="my-link"
                required
            />
        </div>

        <button type="submit">
            Shorten URL
        </button>

    </form>

    <h2>Your Shortened URLs</h2>

    <ul>
        <% links.forEach((link) => { %>

            <% 
                const truncatedURL =
                    link.url.length >= 30
                        ? `${link.url.slice(0, 30)}...`
                        : link.url;
            %>

            <li>
                <a
                    href="/<%= link.shortCode %>"
                    target="_blank"
                >
                    <%= host %>/<%= link.shortCode %>
                </a>

                - <%= truncatedURL %>
            </li>

        <% }) %>
    </ul>

</div>

<script>
    const params = new URLSearchParams(window.location.search);

    if (params.get("success") === "true") {

        alert("Form submitted successfully");

        // Remove ?success=true from the URL
        window.history.replaceState(
            {},
            document.title,
            "/"
        );
    }
</script>

<%- include('./partials/footer') %>