<%- include('./partials/header', { title: "URL Shortner" }) %>

<% if (user) { %>                        
    <h2>You are logged In</h2>
<% } else { %>
    <h2>You are not logged In</h2>
<% } %>

<div class="container">

    <h1>URL Shortner</h1>

    <p class="subtitle">
        Convert long URLs into short and shareable links.
    </p>


      <!-- Zod validation error -->
    <% if (errors && errors.length > 0) { %>
    <div class="error-message">
        <%= errors[0] %>
    </div>
    <% } %>

       <!-- Success message -->
    <% if (success && success.length > 0) { %>
    <div class="success-message">
        <%= success[0] %>
    </div>
    <% } %>

    <form action="/" method="post">

        <div class="form-group">
            <label for="url">Original URL</label>

            <input
                type="text"
                id="url"
                name="url"
                placeholder="https://example.com"
                required
            />
        </div>

        <div class="form-group">
            <label for="shortCode">Custom Short Code</label>

            <input
                type="text"
                id="shortCode"
                name="shortCode"
                placeholder="my-link"
                required
            />
        </div>

        <button type="submit">
            Shorten URL
        </button>

    </form>

    <h2>Your Shortened URLs</h2>

    <ul>
        <% links.forEach((link) => { %>

            <%
                const truncatedURL =
                    link.url.length >= 30
                        ? `${link.url.slice(0, 30)}...`
                        : link.url;
            %>

            <li>
                <a
                    href="/<%= link.shortCode %>"
                    target="_blank"
                >
                    <%= host %>/<%= link.shortCode %>
                </a>

                - <%= truncatedURL %>
            </li>

        <% }) %>
    </ul>

</div>

